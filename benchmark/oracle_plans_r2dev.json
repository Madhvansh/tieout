 "_notes": {
  "A01": "item worded 'Digital Media ARR' (Adobe's label for Digital Media annualized recurring revenue); 'going out of fiscal 2025' read as the FY2025 year-end figure",
  "A07": "'net new money across all of its products' read as BlackRock's total net inflows (long-term plus cash management), item 'total net inflows'",
  "A09": "'In its 2024 annual report ... say' stresses the original report, so as:first_reported",
  "A16": "concept ShareRepurchases, not an item: Visa's cash-flow line 'Repurchase of class A common stock' is its whole repurchase line, so it is not narrower than the concept and the question asks for cash paid",
  "A17": "metric free_cash_flow (operating cash flow less capex) taken as the free cash flow Oracle reports",
  "A18": "cannot: audit fees are a proxy-statement disclosure (rule 12)",
  "A19": "Costco net sales is an item (excludes membership fees, rule 1); warehouses = count in operation at FY2026 year-end",
  "A21": "single item 'Keytruda sales' read as the Keytruda line including Keytruda Qlex; not summed with a separate Qlex item to avoid double counting if the filing combines them",
  "A22": "Q4 written as {fy:2025,q:4} per the Nike Q4 example (executor derives FY less nine months if no Q4 filing)",
  "A24": "Automotive sales line (not total automotive revenues) over consumer vehicles delivered",
  "A25": "filter segments with negative earnings from operations, get the chosen line, abs() for 'how big' (rule 10); assumes one loss-making business",
  "A26": "change = latest (2025 annual report) minus first reported (2024 annual report) via two gets and calc, so the answer is the numeric change; restated op not used",
  "A27": "cannot: Starbucks is not listed",
  "B01": "Primary segment net sales over total year-end store count (all stores sit in Primary; SRS excluded)",
  "B02": "gross revenue = net revenue + |client incentives| (s3); answer s4 = incentives as a share of gross revenue",
  "B05": "item 'CET1 capital ratio (Standardized approach)'; strongest = highest ratio, desc",
  "B10": "same question as A24; same plan",
  "B13": "ranked by Inventory / CostOfRevenue ratio; the x365 constant is dropped (order unchanged)",
  "B14": "answer s1 = rank by operating income (winner and gap); s2 ranks both operating margins",
  "B20": "cannot: U.S. Bancorp is not listed"
 }
}
